# =============================================================================
# Acten — Variables de entorno PRODUCCIÓN
# =============================================================================
# Copia este archivo y rellena las variables.
#
# Si usas Coolify: NO subas el .env real al repo. Pega cada variable en la UI
#                  de Coolify (Environment Variables tab del recurso).
#
# Si vas manual:   cp -n deploy/.env.production.example .env.production y rellena.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DOMINIOS (cámbialos por los tuyos)
# ─────────────────────────────────────────────────────────────────────────────
# Recomendación: subdominio dedicado para API y otro para la app.
# Ejemplo:   PUBLIC_BASE_URL = https://api.acten.ai
#            FRONTEND_URL    = https://app.acten.ai
PUBLIC_BASE_URL=https://api.tudominio.com
FRONTEND_URL=https://app.tudominio.com

# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL — credenciales de la base de datos managed por Docker
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANTE: Usa un password ALEATORIO y FUERTE (>=32 chars). Generador:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# o:
#   openssl rand -base64 48 | tr -d /=+
POSTGRES_DB=acten
POSTGRES_USER=acten
POSTGRES_PASSWORD=__GENERA_UN_PASSWORD_LARGO__

# ─────────────────────────────────────────────────────────────────────────────
# JWT — secreto para firmar los tokens de sesión
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANTE: Genera uno NUEVO para producción (NUNCA reutilices el de dev).
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=__GENERA_UN_SECRETO_DE_64_CHARS_O_MAS__

# ─────────────────────────────────────────────────────────────────────────────
# LLMs — claves de OpenAI y Groq
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI sigue siendo una clave de instalación para embeddings/audio.
# Groq se configura cifrado por empresa en la UI; la variable legacy no
# se usa como respaldo del procesamiento. No pegar claves de ejemplo.
OPENAI_API_KEY=
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FIREFLIES — opcional, para recibir grabaciones procesadas
# ─────────────────────────────────────────────────────────────────────────────
# Si no usas Fireflies aún, deja vacío. Las settings completas (incluido el
# webhook_token) se configuran después en /admin/settings.
FIREFLIES_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
# INFO en producción es razonable. WARNING si quieres menos ruido. DEBUG solo
# para depurar problemas puntuales (deja huellas grandes).
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# OTRAS INTEGRACIONES (Trello / Jira / Azure / ClickUp / SMTP / Calendar OAuth)
# ─────────────────────────────────────────────────────────────────────────────
# NO van aquí — se configuran desde /admin/configuración una vez la plataforma
# esté arriba. Se persisten en la tabla `integrationsetting` cifradas.

# UUID del recurso de Coolify para sus labels Traefik. En un recurso nuevo
# poner SU UUID. Vacío conserva el UUID de la instalación existente.
ACTEN_COOLIFY_UUID=

# Opcional: clave estable independiente para cifrar credenciales.
# Si está vacía se deriva de JWT_SECRET_KEY. Conservarla al restaurar datos;
# no cambiarla en una instalación existente sin migrar sus secretos.
CALENDAR_SECRET_KEY=
# Orígenes HTTPS adicionales separados por coma para empresas con dominio propio.
CORS_EXTRA_ORIGINS=
# Solo para la variante Supabase:
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
