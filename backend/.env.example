# Backend local independiente de Docker. Copiar a backend/.env solo si no existe.
# SQLite no necesita servidor; para PostgreSQL sustituir por su URL de conexión.
DATABASE_URL=sqlite:///./acten.db
SUPABASE_URL=
SUPABASE_KEY=

# OpenAI: embeddings/audio. Groq se configura cifrado por empresa en la UI.
OPENAI_API_KEY=
GROQ_API_KEY=
FIREFLIES_API_KEY=
# El token del webhook de Fireflies se configura desde /admin/settings.

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=4

FRONTEND_URL=http://localhost:4200
PUBLIC_BASE_URL=http://localhost:8000
GOTENBERG_URL=http://localhost:3002
ENVIRONMENT=development
LOG_LEVEL=INFO
