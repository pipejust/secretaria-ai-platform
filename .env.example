# Variables de entorno para `docker compose up` en local.
# Copia este archivo a `.env` y rellena las claves reales.

# === Auth (genera nuevo: python -c "import secrets; print(secrets.token_urlsafe(64))") ===
JWT_SECRET_KEY=x-local-dev-secret-must-be-at-least-32-chars-long-x

# === LLMs ===
OPENAI_API_KEY=
GROQ_API_KEY=

# === Fireflies ===
FIREFLIES_API_KEY=
# webhook_token NO va aquí: se genera automáticamente y vive en
# IntegrationSetting('fireflies').config_json.webhook_token

# === Email ===
RESEND_API_KEY=
FROM_EMAIL=no-reply@notiva.local

# === Supabase opcional (sólo si usas storage o auth de Supabase) ===
SUPABASE_URL=
SUPABASE_KEY=
